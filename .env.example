# Copy to .env (repo root) for local dev; docker compose also interpolates these variables from it.
# Placeholders only — never put real values in this file or commit a filled-in .env.

# MySQL connection string for the server's mysql2 pool (needed when running `node server/server.js` outside compose). In the compose stack the value is set in docker-compose.yml instead.
DATABASE_URL=mysql://user:password@localhost:3306/oliver

# Redis connection string for the BullMQ queue (only needed when running outside compose; compose sets it to redis://redis:6379).
REDIS_URL=redis://localhost:6379

# Parallel analyze.py workers in the job worker (default 1 = serialized analysis).
ANALYZE_CONCURRENCY=1

# Retry cap for failed analyze jobs, exponential backoff with a 5 s base delay (default 3).
ANALYZE_MAX_ATTEMPTS=3

# Google Gemini API key that enables POST /api/videos/:id/report; leave empty to keep AI reports disabled (endpoint returns a clear 503). Free tier is enough for dev.
GEMINI_API_KEY=

# Optional: model used by the report endpoint. Server default when unset/empty: gemini-2.5-flash — swap this one value if Google's free-tier lineup changes (no fallback chain implemented, by decision).
GEMINI_MODEL=

# Optional: python interpreter spawned for analyze.py / metrics.py. Set inside the compose image already; local dev falls back to ./.venv/bin/python when unset/empty.
PYTHON_BIN=
